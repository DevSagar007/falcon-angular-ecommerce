# All variables are optional. Node does not load this file automatically: export them in your
# shell or hosting provider (or run `node --env-file=.env dist/ecommerce-task/server/server.mjs`).

# Absolute origin for canonical URLs, the sitemap and JSON-LD. Read at build time (prerendered pages)
# and at runtime (server-rendered pages, sitemap.xml, robots.txt). Defaults to http://localhost:3000.
SITE_URL=https://future-studios-ecommerce.vercel.app

# Port for the production server (`npm start`). Defaults to 3000.
PORT=3000

# Extra host names the SSR server accepts (comma separated). localhost and the demo domain are
# already allowed in angular.json; requests with other Host headers are rejected (SSRF protection).
# NG_ALLOWED_HOSTS=shop.example.com
